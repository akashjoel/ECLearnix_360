{
  "name": "eclearnix-360-learning-platform",
  "version": "1.0.0",
  "description": "A comprehensive learning platform with AI-powered features, 3D visualizations, and real-time collaboration",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd Back-end && npm install && cd ../front-end && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd Back-end && npm run dev",
    "dev:frontend": "cd front-end && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd Back-end && npm run build",
    "build:frontend": "cd front-end && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd Back-end && npm start",
    "start:frontend": "cd front-end && npm run preview",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd Back-end && npm test",
    "test:frontend": "cd front-end && npm test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd Back-end && npm run lint",
    "lint:frontend": "cd front-end && npm run lint"
  },
  "keywords": [
    "learning-platform",
    "ai",
    "education",
    "react",
    "nodejs",
    "typescript",
    "threejs",
    "firebase"
  ],
      "author": "Learno AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/learno-ai-platform.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/learno-ai-platform/issues"
  },
  "homepage": "https://github.com/your-username/learno-ai-platform#readme"
} 